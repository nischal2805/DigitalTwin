# Sahayak configuration. Copy this file to .env and fill in a key.
# Leave the keys empty to run on Levels 1-2; the council then uses deterministic templates.

# LLM provider: groq | xai | none
LLM_PROVIDER=groq

# Groq API key: paste your key from console.groq.com
GROQ_API_KEY=

# xAI API key: get one at console.x.ai
XAI_API_KEY=

# Model id. Empty = provider default (groq: llama-3.3-70b-versatile, xai: grok-3-mini).
# Verify current model ids in the provider console.
LLM_MODEL=

# API base URL override. Empty = provider default.
LLM_BASE_URL=

# Seconds to wait for the LLM before falling back.
LLM_TIMEOUT_S=6

# Simulation seed and number of held-out runs used for training and evaluation.
SEED=42
N_RUNS=400
